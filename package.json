{
  "name": "gosdir",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:apache": "node scripts/build-apache.mjs",
    "start": "vinext start",
    "check:catalog": "node scripts/check-catalog.mjs",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "oxfmt --ignore-path=.oxfmtignore .",
    "test:availability-policy": "node --test scripts/tests/project-availability-policy.test.mjs",
    "test:admin": "node --test scripts/tests/admin*.test.mjs",
    "admin:start": "node scripts/admin-service.mjs start",
    "admin:stop": "node scripts/admin-service.mjs stop",
    "admin:status": "node scripts/admin-service.mjs status",
    "admin:install": "node scripts/admin-service.mjs install",
    "admin:setup-link": "node scripts/admin-service.mjs setup-link",
    "admin:google": "node scripts/admin-google.mjs",
    "check": "npm run check:catalog && npm run test:availability-policy && npm run test:admin && npm run lint && npm run typecheck",
    "review:freshness": "node scripts/review-project-freshness.mjs",
    "review:availability": "node scripts/review-project-availability.mjs",
    "report:availability": "node scripts/compare-project-availability.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "google-auth-library": "11.3.1",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
