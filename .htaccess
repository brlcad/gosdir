DirectoryIndex index.html
Options -Indexes

<If "%{HTTPS} != 'on'">
    Redirect permanent "/" "https://gosdir.com/"
</If>

SetEnvIf Request_URI "^/(?:index\.html|robots\.txt|favicon\.svg|og\.png|site-assets/[A-Za-z0-9._-]+\.(?:css|js)|(?:contact|contribute|coverage|coverage-beta|directory|glossary|guide|methodology|policy|review|timeline)(?:/index\.html)?/?)?$" gosdir_public
SetEnvIf Request_URI "^/coverage-beta(?:/index\.html)?/?$" gosdir_beta
SetEnvIf Request_URI "^/admin(?:/|$)" gosdir_admin
<RequireAny>
    Require env gosdir_public
    Require env gosdir_admin
</RequireAny>

# The administrative service binds only to loopback. Its API enforces sign-in,
# Origin and CSRF checks. Keep this behind the existing HTTPS redirect.
RewriteEngine On
RewriteCond %{HTTPS} =on
RewriteRule ^admin(?:/(.*))?$ http://127.0.0.1:9137/admin/$1 [P,L]

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src https://ko-fi.com; object-src 'none'; base-uri 'self'; form-action 'self' https://github.com; frame-ancestors 'none'; upgrade-insecure-requests" env=!gosdir_admin
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; img-src 'self' data: https://lh3.googleusercontent.com; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; upgrade-insecure-requests" env=gosdir_admin
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://ko-fi.com\")"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set X-Robots-Tag "noindex, nofollow" env=gosdir_beta
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=gosdir_admin
    Header always set Cache-Control "no-store, private" env=gosdir_admin

    <FilesMatch "^index\.html$">
        Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "^[A-Za-z0-9._-]+-[A-Za-z0-9_-]+\.(?:css|js)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
