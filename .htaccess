DirectoryIndex index.html
Options -Indexes

<If "%{HTTPS} != 'on'">
    Redirect permanent "/" "https://gosdir.com/"
</If>

SetEnvIf Request_URI "^/(?:index\.html|favicon\.svg|og\.png|site-assets/[A-Za-z0-9._-]+\.(?:css|js)|(?:contact|contribute|coverage|directory|glossary|guide|methodology|policy|review|timeline)(?:/index\.html)?/?)?$" gosdir_public
Require env gosdir_public

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://api.github.com; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://github.com; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    <FilesMatch "^index\.html$">
        Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "^[A-Za-z0-9._-]+-[A-Za-z0-9_-]+\.(?:css|js)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
